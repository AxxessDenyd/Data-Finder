{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Data Finder",
  "version": "0.2.3",
  "identifier": "dev.datafinder.app",
  "build": {
    "frontendDist": "../desktop-dist",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Data Finder",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
